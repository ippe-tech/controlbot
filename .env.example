# === Обязательное ===
TELEGRAM_BOT_TOKEN=вставьте_токен_от_BotFather
# Можно несколько chat_id через запятую: 2079052013,8402289160
ALLOWED_CHAT_IDS=2079052013

# === Идентификация ПК в отчётах ===
CLUB_NAME=Восток
PC_NAME=Ресепшен-1

# === Учёт активности ===
ACTIVITY_ENABLED=1
ACTIVITY_AFK_SECONDS=300
ACTIVITY_TRACK_TITLES=1
ACTIVITY_RETENTION_DAYS=30
ACTIVITY_SUMMARY_ENABLED=1
ACTIVITY_SUMMARY_HOUR=21

# === Сайты из истории браузеров ===
BROWSER_SITES_ENABLED=1
BROWSER_SITES_INTERVAL=60

# === Безопасность ===
# Веб-камера по умолчанию выключена. Включать только при письменном согласии.
ALLOW_WEBCAM=0

# === Пороговые оповещения ===
LOW_BATTERY_THRESHOLD=20
HIGH_RAM_THRESHOLD=90
HIGH_DISK_THRESHOLD=90
MONITORING_INTERVAL=60

# === Прочее ===
BRIGHTNESS_STEP_PERCENT=10
SHUTDOWN_DELAY_SECONDS=30
VOLUME_DOWN_STEPS=2

# === Автообновление ===
# github  -> последний релиз репозитория (рекомендуется)
# manifest -> latest.json на своём сервере
UPDATE_SOURCE=github
UPDATE_REPO=ippe-tech/controlbot
# Только для приватного репозитория:
# UPDATE_TOKEN=
